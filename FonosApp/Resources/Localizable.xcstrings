    },
    "%1$@ and %2$@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@和%2$@"
          }
        }
      }
    },
    "%1$@ at %2$@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@）"
          }
        }
      }
    },
    "After withdrawal, network STT and LLM requests are blocked until you review and allow the endpoint again. Local Apple Speech remains available." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撤回后，网络 STT 和 LLM 请求会被阻止，直到您重新检查并允许相应端点。本地 Apple 语音识别仍可使用。"
          }
        }
      }
    },
    "Allow" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许"
          }
        }
      }
    },
    "Allow & Add" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许并添加"
          }
        }
      }
    },
    "Allow & Save" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许并保存"
          }
        }
      }
    },
    "Allow Remote AI Processing?" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许远程 AI 处理？"
          }
        }
      }
    },
    "API keys" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 密钥"
          }
        }
      }
    },
    "API keys are stored in Apple Keychain. They are not stored in AppConfig or ordinary UserDefaults." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 密钥存储在 Apple 钥匙串中，不会存入 AppConfig 或普通的 UserDefaults。"
          }
        }
      }
    },
    "Before Fonos sends voice or text to a configured AI endpoint, it identifies the recipient and asks for your permission. The provider processes that content under its own terms and privacy policy." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Fonos 将语音或文本发送到已配置的 AI 端点前，会先标明接收方并征求您的许可。服务提供商会依据其自身的条款和隐私政策处理这些内容。"
          }
        }
      }
    },
    "Configured AI services" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已配置的 AI 服务"
          }
        }
      }
    },
    "Configured endpoints are ready" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已配置的端点均已就绪"
          }
        }
      }
    },
    "Copies the same final text after earlier outputs succeed." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前面的输出成功后，将同一份最终文本复制到剪贴板。"
          }
        }
      }
    },
    "Data on this iPhone" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 iPhone 上的数据"
          }
        }
      }
    },
    "Deleting data" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除数据"
          }
        }
      }
    },
    "Dictation history, notes, vocabulary, and configuration stay on this device unless you choose an output or network model that sends content elsewhere." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非您选择会将内容发送到其他位置的输出或网络模型，否则听写历史、笔记、词汇和配置都只保留在此设备上。"
          }
        }
      }
    },
    "Fonos blocks voice and text requests to a configured endpoint until you review the recipient and allow that destination. Permissions can be withdrawn under General → Privacy & Data Sharing." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您检查接收方并允许相应目标前，Fonos 会阻止向已配置端点发送语音和文本。您可以在“通用”→“隐私与数据共享”中撤回权限。"
          }
        }
      }
    },
    "Fonos contains no third-party advertising or analytics SDK and does not track you across other companies’ apps or websites." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonos 不含第三方广告或分析 SDK，也不会跨其他公司的 App 或网站跟踪您。"
          }
        }
      }
    },
    "Fonos records only for features you start and uses microphone and Speech permissions granted through iOS. During an explicit, time-limited Keyboard Ready session, microphone input stays active but idle buffers are discarded; Fonos retains audio only after you tap the keyboard microphone and releases it after that recipe finishes." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonos 只会为您主动启动的功能录音，并使用您通过 iOS 授予的麦克风和语音识别权限。在您明确启动且有时间限制的“键盘语音待命”会话期间，麦克风输入会保持启用，但空闲音频缓冲区会被丢弃；只有当您轻点 Fonos 键盘上的麦克风后，Fonos 才会保留音频，并在该配方运行结束后释放。"
          }
        }
      }
    },
    "Fonos will send %1$@ to %2$@ only when you run a recipe that uses this model. The provider may process the content under its own privacy policy. Your API key remains in Apple Keychain." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonos 仅会在您运行使用此模型的配方时，将%1$@发送给%2$@。服务提供商可能会依据其自身的隐私政策处理这些内容。您的 API 密钥会继续保存在 Apple 钥匙串中。"
          }
        }
      }
    },
    "HTTPS required for %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 需要使用 HTTPS"
          }
        }
      }
    },
    "Microphone and Apple Speech" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风与 Apple 语音识别"
          }
        }
      }
    },
    "No configured AI endpoint currently has permission to receive voice or text." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前没有已配置的 AI 端点获准接收语音或文本。"
