        }
      }
    },
    "Outputs receive the same final text in listed order; they do not feed into one another." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各输出会按列表顺序接收同一份最终文本，彼此不会串联。"
